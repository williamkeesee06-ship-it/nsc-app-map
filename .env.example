# Frontend (must be prefixed VITE_ to be exposed to the browser)
VITE_GOOGLE_MAPS_API_KEY=
# 811 — Firebase web config for invoking the Callable Functions (ITIC bot etc.)
# via the Firebase Functions SDK. Copy these from the Firebase console
# (Project Settings → General → Your apps → Web app). See README-811-DEPLOY.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Required for Ziply print browser uploads. Enable Firebase Auth → Anonymous
# sign-in and deploy storage.rules so authenticated writes to ziply-prints/** work.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend / Vercel functions (server-only, NEVER prefixed VITE_)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full PEM. \n escapes are auto-converted in code.
FIREBASE_PRIVATE_KEY=

# Phase 2 — Smartsheet
SMARTSHEET_API_TOKEN=
SMARTSHEET_SHEET_ID=

# Ziply — separate Smartsheet sheet holding the Ziply FTTH tracker. When set,
# sync pulls this sheet in addition to SMARTSHEET_SHEET_ID and normalizes its
# rows with the Ziply column mapping. Leave blank to disable Ziply sync.
ZIPLY_SMARTSHEET_SHEET_ID=

# Phase 2 — Sync filter (default: "Billy Keesee")
SYNC_SUPERVISOR=Billy Keesee

# Phase 2 — Server-side geocoding key. If unset, falls back to
# VITE_GOOGLE_MAPS_API_KEY, but referrer-restricted browser keys will fail.
# Recommend a separate backend key (no referrer restriction, or IP-restricted).
GOOGLE_GEOCODING_API_KEY=

# Lumina (Gemini Live + chat). Server-side only — never expose to browser.
GEMINI_API_KEY=
