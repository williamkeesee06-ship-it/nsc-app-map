{
  "manifest_version": 3,
  "name": "NSC ITIC Copilot",
  "version": "1.0.0",
  "description": "Chrome Extension to assist with hybrid manual/automated ITIC dig ticket filing.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://nsc-app-map.vercel.app/*",
    "http://localhost:5173/*",
    "https://wa.itic.occinc.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nsc-app-map.vercel.app/*",
        "http://localhost:5173/*"
      ],
      "js": ["content-nsc.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://wa.itic.occinc.com/*"
      ],
      "js": ["content-itic.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "NSC ITIC Copilot"
  }
}
